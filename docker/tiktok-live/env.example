# Copy to tiktok-live.env for `docker run --env-file`, or add each line as a
# Hugging Face Space secret. Never commit the filled-in file.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_TOKENS=        # optional: several bots, comma separated
TELEGRAM_CHANNEL_ID=
# Full-length videos up to 2 GB each (free keys from my.telegram.org).
# Without them full videos still go out, as 48 MB Bot API pieces.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Bearer token for /status and POST /poll. Any long random string.
TIKTOK_STATUS_TOKEN=
# Optional tuning
# TIKTOK_POLL_SECONDS=30
# TIKTOK_SYNC_SECONDS=600
# TIKTOK_RECORD_ALL=0
# TIKTOK_FULL_VIDEO=1
# TIKTOK_FULL_CHANNEL_ID=
# TIKTOK_TRACKED=
